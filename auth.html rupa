<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>MeowWoof — Sign In</title>
   <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
   <link rel="stylesheet" href="auth.css">
</head>
<body>


<!-- Animated background -->
<div class="bg-wrap" aria-hidden="true">
   <div class="blob blob-1"></div>
   <div class="blob blob-2"></div>
   <div class="blob blob-3"></div>
   <div class="pawprints">
       <span>🐾</span><span>🐕</span><span>🐈</span><span>🐾</span>
       <span>🐶</span><span>🐱</span><span>🐾</span><span>🦮</span>
   </div>
</div>


<div class="auth-container">


   <!-- Left panel -->
   <div class="left-panel">
       <div class="left-content">
           <div class="brand">
               <span class="brand-paw">🐾</span>
               <span class="brand-name">MeowWoof</span>
           </div>
           <h1 class="left-title">Care for every<br><span class="highlight">stray soul.</span></h1>
           <p class="left-sub">Join our community of volunteers and vets working together to protect stray animals across the city.</p>


           <div class="role-cards">
               <div class="role-card" id="roleVolunteer" onclick="selectRole('volunteer')">
                   <div class="role-icon">🙋</div>
                   <div>
                       <div class="role-title">Volunteer</div>
                       <div class="role-desc">Feed & care for strays</div>
                   </div>
                   <div class="role-check" id="checkVolunteer">✓</div>
               </div>
               <div class="role-card" id="roleVet" onclick="selectRole('vet')">
                   <div class="role-icon">🩺</div>
                   <div>
                       <div class="role-title">Veterinarian</div>
                       <div class="role-desc">Provide medical care</div>
                   </div>
                   <div class="role-check" id="checkVet">✓</div>
               </div>
           </div>




       </div>
   </div>


   <!-- Right panel — form -->
   <div class="right-panel">
       <div class="form-card">


           <!-- Tab switcher -->
           <div class="tab-row">
               <button class="tab active" id="tabLogin" onclick="switchTab('login')">Sign In</button>
               <button class="tab" id="tabSignup" onclick="switchTab('signup')">Sign Up</button>
           </div>


           <!-- LOGIN FORM -->
           <div id="loginForm" class="form-section">
               <div class="form-intro">
                   <h2>Welcome back! <span>👋</span></h2>
                   <p>Sign in to continue helping strays.</p>
               </div>


               <div class="selected-role-badge" id="loginRoleBadge">
                   <span id="loginRoleIcon">🙋</span>
                   <span id="loginRoleLabel">Signing in as Volunteer</span>
               </div>


               <div class="field-group">
                   <label>Email Address</label>
                   <div class="input-wrap">
                       <span class="input-icon">✉️</span>
                       <input type="email" id="loginEmail" placeholder="your@email.com">
                   </div>
               </div>


               <div class="field-group">
                   <label>Password</label>
                   <div class="input-wrap">
                       <span class="input-icon">🔒</span>
                       <input type="password" id="loginPassword" placeholder="••••••••">
                       <button class="toggle-pw" onclick="togglePw('loginPassword', this)">👁</button>
                   </div>
               </div>


               <div class="form-row-inline">
                   <label class="remember-label">
                       <input type="checkbox" id="rememberMe"> Remember me
                   </label>
                   <a href="#" class="forgot-link">Forgot password?</a>
               </div>


               <button class="submit-btn" onclick="handleLogin()">
                   <span>Sign In</span>
                   <span class="btn-arrow">→</span>
               </button>


               <div class="form-footer">
                   Don't have an account? <a href="#" onclick="switchTab('signup')">Sign up</a>
               </div>
           </div>


           <!-- SIGNUP FORM -->
           <div id="signupForm" class="form-section hidden">
               <div class="form-intro">
                   <h2>Join us today! <span>🐾</span></h2>
                   <p>Create your account and start making a difference.</p>
               </div>


               <div class="selected-role-badge" id="signupRoleBadge">
                   <span id="signupRoleIcon">🙋</span>
                   <span id="signupRoleLabel">Signing up as Volunteer</span>
               </div>


               <div class="two-col">
                   <div class="field-group">
                       <label>First Name</label>
                       <div class="input-wrap">
                           <span class="input-icon">👤</span>
                           <input type="text" id="signupFirst" placeholder="Nusiba">
                       </div>
                   </div>
                   <div class="field-group">
                       <label>Last Name</label>
                       <div class="input-wrap">
                           <span class="input-icon">👤</span>
                           <input type="text" id="signupLast" placeholder="Alam">
                       </div>
                   </div>
               </div>


               <div class="field-group">
                   <label>Email Address</label>
                   <div class="input-wrap">
                       <span class="input-icon">✉️</span>
                       <input type="email" id="signupEmail" placeholder="your@email.com">
                   </div>
               </div>


               <div class="field-group">
                   <label>Phone Number</label>
                   <div class="input-wrap">
                       <span class="input-icon">📱</span>
                       <input type="tel" id="signupPhone" placeholder="+880 1XXX XXXXXX">
                   </div>
               </div>


               <!-- Vet-only field -->
               <div class="field-group vet-only hidden" id="specializationField">
                   <label>Specialization</label>
                   <div class="input-wrap">
                       <span class="input-icon">🩺</span>
                       <select id="signupSpec">
                           <option value="">Select specialization</option>
                           <option value="general">General Practice</option>
                           <option value="surgery">Surgery</option>
                           <option value="dermatology">Dermatology</option>
                           <option value="orthopedics">Orthopedics</option>
                           <option value="internal">Internal Medicine</option>
                       </select>
                   </div>
               </div>


               <!-- Volunteer-only field -->
               <div class="field-group vol-only" id="areaField">
                   <label>Preferred Area</label>
                   <div class="input-wrap">
                       <span class="input-icon">📍</span>
                       <select id="signupArea">
                           <option value="">Select area</option>
                       </select>
                   </div>
               </div>


               <div class="two-col">
                   <div class="field-group">
                       <label>Password</label>
                       <div class="input-wrap">
                           <span class="input-icon">🔒</span>
                           <input type="password" id="signupPassword" placeholder="••••••••" oninput="checkStrength(this.value)">
                           <button class="toggle-pw" onclick="togglePw('signupPassword', this)">👁</button>
                       </div>
                       <div class="strength-bar">
                           <div class="strength-fill" id="strengthFill"></div>
                       </div>
                       <div class="strength-label" id="strengthLabel"></div>
                   </div>
                   <div class="field-group">
                       <label>Confirm Password</label>
                       <div class="input-wrap">
                           <span class="input-icon">🔒</span>
                           <input type="password" id="signupConfirm" placeholder="••••••••">
                           <button class="toggle-pw" onclick="togglePw('signupConfirm', this)">👁</button>
                       </div>
                   </div>
               </div>


               <label class="terms-label">
                   <input type="checkbox" id="agreeTerms">
                   I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
               </label>


               <button class="submit-btn" onclick="handleSignup()">
                   <span>Create Account</span>
                   <span class="btn-arrow">🐾</span>
               </button>


               <div class="form-footer">
                   Already have an account? <a href="#" onclick="switchTab('login')">Sign in</a>
               </div>
           </div>


       </div>
   </div>
</div>


<!-- Toast -->
<div id="toast" class="toast"></div>


<script src="auth.js"></script>
</body>
</html>

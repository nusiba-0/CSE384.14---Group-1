function loadReviews() {
   fetch(`${API_URL}/reviews`).then(r => r.json()).then(reviews => {
       const tbody = document.getElementById('reviewsList');
       const empty = document.getElementById('reviewsEmpty');
       tbody.innerHTML = '';
       if (!reviews.length) { empty.style.display = 'block'; return; }
       empty.style.display = 'none';
       reviews.forEach(r => {
           const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
           const date  = new Date(r.reviewDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
           tbody.innerHTML += `<tr>
               <td><strong>${r.volunteer?.name || '—'}</strong></td>
               <td>${r.area?.name || '—'}</td>
               <td><span class="stars-display">${stars}</span></td>
               <td>${r.comment || '—'}</td>
               <td>${date}</td>
               <td><button class="delete-btn" onclick="deleteReview(${r.id})">Delete</button></td>
           </tr>`;
       });
   }).catch(() => {});
}


function saveReview() {
   const vol    = document.getElementById('reviewVolunteer').value;
   const area   = document.getElementById('reviewArea').value;
   const rating = parseInt(document.getElementById('reviewRating').value);
   if (!vol || !area || !rating) { showToast(' Please fill all fields and select a rating', 'error'); return; }
   const body = {
       rating,
       comment:    document.getElementById('reviewComment').value || null,
       reviewDate: new Date().toISOString(),
       volunteer:  { id: parseInt(vol) },
       area:       { id: parseInt(area) }
   };
   fetch(`${API_URL}/reviews`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
       .then(r => r.json()).then(() => {
       showToast('⭐ Review submitted!');
       closeModal('reviewModal');
       document.getElementById('reviewComment').value = '';
       document.getElementById('reviewRating').value = '0';
       document.querySelectorAll('.star').forEach(s => s.classList.remove('active'));
       loadReviews(); loadDashboard();
   }).catch(() => showToast(' Error', 'error'));
}


function deleteReview(id) {
   if (!confirm('Delete this review?')) return;
   fetch(`${API_URL}/reviews/${id}`, { method: 'DELETE' })
       .then(() => { showToast(' Review removed'); loadReviews(); loadDashboard(); })
       .catch(() => showToast(' Error', 'error'));
}




function loadAdoptions() {
   fetch(`${API_URL}/adoptions`).then(r => r.json()).then(adoptions => {
       const tbody = document.getElementById('adoptionsList');
       const empty = document.getElementById('adoptionsEmpty');
       tbody.innerHTML = '';
       if (!adoptions.length) { empty.style.display = 'block'; return; }
       empty.style.display = 'none';
       adoptions.forEach(a => {
           const date   = new Date(a.requestDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
           const badge  = `<span class="badge badge-${a.status}">${a.status}</span>`;
           const actions = a.status === 'pending'
               ? `<button class="approve-btn" onclick="updateAdoptionStatus(${a.id},'approved')">Approve</button>
                  <button class="reject-btn"  onclick="updateAdoptionStatus(${a.id},'rejected')">Reject</button>`
               : `<button class="delete-btn"  onclick="deleteAdoption(${a.id})">Delete</button>`;
           tbody.innerHTML += `<tr>
               <td><strong>${a.animal?.name || '—'}</strong> (${a.animal?.type || ''})</td>
               <td>${a.volunteer?.name || '—'}</td>
               <td>${badge}</td>
               <td>${date}</td>
               <td class="action-btns">${actions}</td>
           </tr>`;
       });
   }).catch(() => {});
}


function saveAdoption() {
   const animal    = document.getElementById('adoptionAnimal').value;
   const volunteer = document.getElementById('adoptionVolunteer').value;
   if (!animal || !volunteer) { showToast(' Please select animal and volunteer', 'error'); return; }
   const body = {
       requestDate: new Date().toISOString(),
       status:      'pending',
       animal:      { id: parseInt(animal) },
       volunteer:   { id: parseInt(volunteer) }
   };
   fetch(`${API_URL}/adoptions`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
       .then(r => r.json()).then(() => {
       showToast(' Adoption request submitted!');
       closeModal('adoptionModal');
       loadAdoptions(); loadDashboard();
   }).catch(() => showToast(' Error', 'error'));
}


function updateAdoptionStatus(id, status) {
   fetch(`${API_URL}/adoptions/${id}/status?status=${status}`, { method: 'PUT' })
       .then(r => r.json()).then(() => {
       showToast(status === 'approved' ? ' Adoption approved!' : ' Adoption rejected');
       loadAdoptions(); loadDashboard();
   }).catch(() => showToast(' Error', 'error'));
}


function deleteAdoption(id) {
   if (!confirm('Delete this request?')) return;
   fetch(`${API_URL}/adoptions/${id}`, { method: 'DELETE' })
       .then(() => { showToast(' Request removed'); loadAdoptions(); loadDashboard(); })
       .catch(() => showToast(' Error', 'error'));
}


// ===== POPULATE SELECTS =====
function populateSelects() {
   fetch(`${API_URL}/areas`).then(r => r.json()).then(areas => {
       ['animalArea', 'foodArea', 'reviewArea'].forEach(id => {
           const sel = document.getElementById(id);
           if (!sel) return;
           sel.innerHTML = '<option value="">Select area</option>';
           areas.forEach(a => sel.innerHTML += `<option value="${a.id}">${a.name}</option>`);
       });
   }).catch(() => {});


   fetch(`${API_URL}/animals`).then(r => r.json()).then(animals => {
       ['medicineAnimal', 'adoptionAnimal'].forEach(id => {
           const sel = document.getElementById(id);
           if (!sel) return;
           sel.innerHTML = '<option value="">Select animal</option>';
           animals.forEach(a => sel.innerHTML += `<option value="${a.id}">${a.name} (${a.type})</option>`);
       });
   }).catch(() => {});


   fetch(`${API_URL}/volunteers`).then(r => r.json()).then(vols => {
       ['foodVolunteer', 'reviewVolunteer', 'adoptionVolunteer'].forEach(id => {
           const sel = document.getElementById(id);
           if (!sel) return;
           sel.innerHTML = '<option value="">Select volunteer</option>';
           vols.forEach(v => sel.innerHTML += `<option value="${v.id}">${v.name}</option>`);
       });
   }).catch(() => {});


   fetch(`${API_URL}/vets`).then(r => r.json()).then(vets => {
       const sel = document.getElementById('medicineVet');
       if (!sel) return;
       sel.innerHTML = '<option value="">Select vet (optional)</option>';
       vets.forEach(v => sel.innerHTML += `<option value="${v.id}">${v.name} — ${v.specialization || ''}</option>`);
   }).catch(() => {});
}

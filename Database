SELECT
    fd.id,
    a.name           AS area,
    v.name           AS distributed_by,
    fd.quantity,
    fd.distribution_date,
    fd.notes
FROM food_distribution fd
JOIN  areas      a ON fd.area_id      = a.id
LEFT JOIN volunteers v ON fd.volunteer_id = v.id
ORDER BY fd.distribution_date DESC;


SELECT
    a.name                    AS area_name,
    COUNT(fd.id)              AS distribution_sessions,
    SUM(fd.quantity)          AS total_kg,
    ROUND(AVG(fd.quantity),2) AS avg_kg_per_session
FROM areas a
LEFT JOIN food_distribution fd ON a.id = fd.area_id
GROUP BY a.id, a.name
ORDER BY total_kg DESC;

SELECT
    ar.name              AS area,
    ar.capacity          AS max_capacity,
    COUNT(a.id)          AS current_animals,
    COUNT(a.id) - ar.capacity AS overflow
FROM areas ar
LEFT JOIN animals a ON ar.id = a.area_id
GROUP BY ar.id, ar.name, ar.capacity
HAVING COUNT(a.id) > ar.capacity;

SELECT
    a.name          AS area_name,
    COUNT(an.id)    AS animal_count
FROM areas a
LEFT JOIN animals           an ON a.id = an.area_id
LEFT JOIN food_distribution fd ON a.id = fd.area_id
    AND MONTH(fd.distribution_date) = MONTH(NOW())
    AND YEAR(fd.distribution_date)  = YEAR(NOW())
WHERE fd.id IS NULL
GROUP BY a.id, a.name
HAVING animal_count > 0;


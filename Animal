package org.example.meowwoof.model;


import jakarta.persistence.*;
import lombok.*;


@Entity
@Table(name = "animals")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class Animal {
   @Id
   @GeneratedValue(strategy = GenerationType.IDENTITY)
   private Integer id;


   private String name;
   private String type;
   private String healthStatus;
   private Boolean isVaccinated;
   private Integer age;


   @ManyToOne
   @JoinColumn(name = "area_id")
   private Area area;
}


